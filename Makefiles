.PHONY: setup run test lint format

setup:
	pip install --upgrade pip
	pip install flask pandas ruff pytest
	@echo "Dependencias base instaladas para Termux con éxito."

run:
	python src/openjarvis/web/app.py

test:
	pytest tests/ -q --tb=short

lint:
	ruff check src/ tests/

format:
	ruff format src/ tests/
